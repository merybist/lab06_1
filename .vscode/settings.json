{
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/tests/**"
    ],
    "files.associations": {
        "*.cpp": "cpp",
        "*.h": "cpp"
    },
    "testMate.cpp.test.parallelExecutionLimit": 1,
    "testMate.cpp.test.workingDirectory": "${workspaceFolder}",
    "testMate.cpp.discovery.gracePeriodForMissing": 10,
    "testMate.cpp.test.advancedExecutables": [
        {
            "pattern": "UnitTest_06_1_it",
            "cwd": "${workspaceFolder}"
        },
        {
            "pattern": "UnitTest_06_1_rec",
            "cwd": "${workspaceFolder}"
        }
    ],
    "testMate.cpp.log.logLevel": "debug"
}