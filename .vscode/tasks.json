{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. Run Iterative Program (Lab_06_1_it)",
            "type": "shell",
            "command": "clang++ -std=c++17 -Wall Lab_06_1_it.cpp -o Lab_06_1_it && ./Lab_06_1_it",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "label": "2. Run Recursive Program (Lab_06_1_rec)",
