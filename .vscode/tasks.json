        },
        {
            "label": "5. Run ALL Unit Tests",
            "type": "shell",
            "command": "echo '=== Iterative Unit Tests ===' && clang++ -std=c++17 -I./tests tests/UnitTest_06_1_it.cpp -o UnitTest_06_1_it && ./UnitTest_06_1_it && echo '' && echo '=== Recursive Unit Tests ===' && clang++ -std=c++17 -I./tests tests/UnitTest_06_1_rec.cpp -o UnitTest_06_1_rec && ./UnitTest_06_1_rec",
